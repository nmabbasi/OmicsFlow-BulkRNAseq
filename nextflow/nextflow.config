manifest {
    name            = 'OmicsFlow-BulkRNAseq'
    author          = 'Nasir Mahmood Abbasi'
    description     = 'End-to-end bulk RNA-seq pipeline: QC -> Trimming -> Mapping -> Quantification'
    mainScript      = 'main.nf'
    version         = '1.1.0'
}

params {
    samplesheet       = null
    hisat2_index      = null
    gtf_file          = null
    outdir            = 'results'
    help              = false
    publish_dir_mode  = 'copy'

    // Trimming
    trim_min_length   = 30

    // featureCounts
    fc_feature_type   = 'exon'
    fc_attribute_type = 'gene_id'
    fc_strandedness   = 0

    // Resource limits
    max_cpus          = 16
    max_memory        = '64.GB'
    max_time          = '24.h'
}

profiles {
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = '--account=your_account'
    }
    conda {
        conda.enabled          = true
        process.conda          = "${projectDir}/envs/omicsflow.yaml"
    }
    local {
        process.executor       = 'local'
        params.max_cpus        = 2
        params.max_memory      = '4.GB'
        params.max_time        = '4.h'
    }
}

process {
    withLabel: 'process_low' {
        cpus   = { check_max(2,    'cpus')   }
        memory = { check_max(8.GB, 'memory') }
        time   = { check_max(4.h,  'time')   }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max(8,     'cpus')   }
        memory = { check_max(32.GB, 'memory') }
        time   = { check_max(12.h,  'time')   }
    }
    withLabel: 'process_high' {
        cpus   = { check_max(16,    'cpus')   }
        memory = { check_max(64.GB, 'memory') }
        time   = { check_max(24.h,  'time')   }
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) > 0)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
}
